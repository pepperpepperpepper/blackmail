# Copy to tools/device.env (not committed) and fill in for your setup.

# The machine the iPad is plugged into, reached over SSH (user@host).
JUMP_HOST=user@localhost
JUMP_PORT=22

# Where the app's bundle lives on the device (find it with:
#   ls -d /var/containers/Bundle/Application/*/Blackmail.app).
IPAD_BUNDLE_PATH=/var/containers/Bundle/Application/<UUID>/Blackmail.app

# Signing material and the ad-hoc profile.
SIGN_DIR=$HOME/.apple-signing
PROFILE_FILE=adhoc.mobileprovision
PROFILE_NAME="the ad-hoc profile"
